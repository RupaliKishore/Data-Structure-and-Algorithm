Get Watched Videos by Your Friends


import java.util.*;

class Solution {
    public List<String> watchedVideosByFriends(List<List<String>> watchedVideos, 
                                                 int[][] friends, 
                                                 int id, 
                                                 int level) {
        int n = friends.length;
        
        // BFS to find all people at exactly 'level' distance
        boolean[] visited = new boolean[n];
        Queue<Integer> queue = new LinkedList<>();
        queue.offer(id);
        visited[id] = true;
        
        int currentLevel = 0;
        List<Integer> targetFriends = new ArrayList<>();
        
        while (!queue.isEmpty()) {
            int size = queue.size();
            targetFriends.clear();
            
            for (int i = 0; i < size; i++) {
                int person = queue.poll();
                
                if (currentLevel == level) {
                    targetFriends.add(person);
                }
                
                for (int friend : friends[person]) {
                    if (!visited[friend]) {
                        visited[friend] = true;
                        queue.offer(friend);
                    }
                }
            }
            
            if (currentLevel == level) break;
            currentLevel++;
        }
        
        // Count video frequencies from target friends
        Map<String, Integer> freq = new HashMap<>();
        for (int person : targetFriends) {
            for (String video : watchedVideos.get(person)) {
                freq.put(video, freq.getOrDefault(video, 0) + 1);
            }
        }
        
        // Sort by frequency ascending, then by video name
        List<String> result = new ArrayList<>(freq.keySet());
        result.sort((a, b) -> {
            if (freq.get(a).equals(freq.get(b))) {
                return a.compareTo(b);
            }
            return freq.get(a) - freq.get(b);
        });
        
        return result;
    }
}
