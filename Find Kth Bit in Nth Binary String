Find Kth Bit in Nth Binary String



class Solution {
    public char findKthBit(int n, int k) {
        // Base case
        if (n == 1) return '0';
        
        int length = (1 << n) - 1; // 2^n - 1
        int mid = length / 2 + 1;  // Middle position (1-indexed)
        
        if (k == mid) {
            return '1';  // Middle bit is always '1'
        } else if (k < mid) {
            // k is in the left half (S_{n-1})
            return findKthBit(n - 1, k);
        } else {
            // k is in the right half (reverse(invert(S_{n-1})))
            // Find corresponding position in S_{n-1}
            int posInS_n1 = length - k + 1;
            char bit = findKthBit(n - 1, posInS_n1);
            // Invert the bit
            return bit == '0' ? '1' : '0';
        }
    }
}
