 K-Concatenation Maximum Sum



class Solution {
    private static final int MOD = 1_000_000_007;
    
    public int kConcatenationMaxSum(int[] arr, int k) {
        long totalSum = 0;
        for (int num : arr) {
            totalSum += num;
        }
        
        // Case 1: Single array
        long maxSubarraySingle = kadane(arr);
        
        if (k == 1) {
            return (int) (Math.max(0, maxSubarraySingle) % MOD);
        }
        
        // Case 2: Two arrays concatenated
        int[] doubleArr = new int[arr.length * 2];
        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < arr.length; j++) {
                doubleArr[i * arr.length + j] = arr[j];
            }
        }
        long maxSubarrayDouble = kadane(doubleArr);
        
        // If totalSum <= 0, best is within 2 copies
        if (totalSum <= 0) {
            return (int) (Math.max(0, maxSubarrayDouble) % MOD);
        }
        
        // Case 3: totalSum > 0 and k > 2
        // Best subarray = max subarray in 2 copies + (k-2) * totalSum
        long result = maxSubarrayDouble + (k - 2) * totalSum;
        return (int) (Math.max(0, result) % MOD);
    }
    
    private long kadane(int[] arr) {
        long maxEndingHere = 0;
        long maxSoFar = 0;
        
        for (int num : arr) {
            maxEndingHere = Math.max(0, maxEndingHere + num);
            maxSoFar = Math.max(maxSoFar, maxEndingHere);
        }
        
        return maxSoFar;
    }
}
