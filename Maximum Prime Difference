 Maximum Prime Difference




public class MaximumPrimeDifference {
    public static void main(String[] args) {
        Solution sol = new Solution();
        
        int[] nums1 = {4, 2, 9, 5, 3};
        System.out.println(sol.maximumPrimeDifference(nums1)); // 3
        
        int[] nums2 = {4, 8, 2, 8};
        System.out.println(sol.maximumPrimeDifference(nums2)); // 0
        
        int[] nums3 = {2, 2, 2, 2};
        System.out.println(sol.maximumPrimeDifference(nums3)); // 3
        
        int[] nums4 = {1, 2, 3, 4, 5, 6, 7};
        System.out.println(sol.maximumPrimeDifference(nums4)); // 5 (index 1 to 6)
        
        int[] nums5 = {1, 4, 6, 8, 10};
        System.out.println(sol.maximumPrimeDifference(nums5)); // 0 (no primes → 0)
    }
}

class Solution {
    public int maximumPrimeDifference(int[] nums) {
        int firstPrime = -1;
        int lastPrime = -1;
        
        for (int i = 0; i < nums.length; i++) {
            if (isPrime(nums[i])) {
                if (firstPrime == -1) {
                    firstPrime = i;
                }
                lastPrime = i;
            }
        }
        
        // If no primes found, return 0
        if (firstPrime == -1) return 0;
        
        return lastPrime - firstPrime;
    }
    
    private boolean isPrime(int n) {
        if (n <= 1) return false;
        if (n == 2) return true;
        if (n % 2 == 0) return false;
        
        for (int i = 3; i * i <= n; i += 2) {
            if (n % i == 0) return false;
        }
        return true;
    }
}
