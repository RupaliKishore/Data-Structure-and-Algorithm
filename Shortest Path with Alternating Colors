 Shortest Path with Alternating Colors


import java.util.*;

public class ShortestPathAlternatingColors {
    public static void main(String[] args) {
        Solution sol = new Solution();
        
        // Example 1
        int n1 = 3;
        int[][] redEdges1 = {{0,1},{1,2}};
        int[][] blueEdges1 = {};
        System.out.println(Arrays.toString(sol.shortestAlternatingPaths(n1, redEdges1, blueEdges1)));
        // Output: [0,1,-1]
        
        // Example 2
        int n2 = 3;
        int[][] redEdges2 = {{0,1}};
        int[][] blueEdges2 = {{2,1}};
        System.out.println(Arrays.toString(sol.shortestAlternatingPaths(n2, redEdges2, blueEdges2)));
        // Output: [0,1,-1]
        
        // Example 3
        int n3 = 5;
        int[][] redEdges3 = {{0,1},{1,2},{2,3},{3,4}};
        int[][] blueEdges3 = {{1,2},{2,3},{3,1}};
        System.out.println(Arrays.toString(sol.shortestAlternatingPaths(n3, redEdges3, blueEdges3)));
    }
}

class Solution {
    public int[] shortestAlternatingPaths(int n, int[][] redEdges, int[][] blueEdges) {
        List<Integer>[] redAdj = new ArrayList[n];
        List<Integer>[] blueAdj = new ArrayList[n];
        
        for (int i = 0; i < n; i++) {
            redAdj[i] = new ArrayList<>();
            blueAdj[i] = new ArrayList<>();
        }
        
        for (int[] edge : redEdges) {
            redAdj[edge[0]].add(edge[1]);
        }
        
        for (int[] edge : blueEdges) {
            blueAdj[edge[0]].add(edge[1]);
        }
        
        int[][] dist = new int[2][n];
        for (int i = 0; i < 2; i++) {
            Arrays.fill(dist[i], Integer.MAX_VALUE);
        }
        
        Queue<int[]> queue = new LinkedList<>();
        dist[0][0] = 0;
        dist[1][0] = 0;
        queue.offer(new int[]{0, 0});
        queue.offer(new int[]{0, 1});
        
        while (!queue.isEmpty()) {
            int[] curr = queue.poll();
            int node = curr[0];
            int lastColor = curr[1];
            
            if (lastColor == 0) { // Last was red, take blue next
                for (int neighbor : blueAdj[node]) {
                    if (dist[1][neighbor] > dist[0][node] + 1) {
                        dist[1][neighbor] = dist[0][node] + 1;
                        queue.offer(new int[]{neighbor, 1});
                    }
                }
            } else { // Last was blue, take red next
                for (int neighbor : redAdj[node]) {
                    if (dist[0][neighbor] > dist[1][node] + 1) {
                        dist[0][neighbor] = dist[1][node] + 1;
                        queue.offer(new int[]{neighbor, 0});
                    }
                }
            }
        }
        
        int[] answer = new int[n];
        for (int i = 0; i < n; i++) {
            answer[i] = Math.min(dist[0][i], dist[1][i]);
            if (answer[i] == Integer.MAX_VALUE) {
                answer[i] = -1;
            }
        }
        
        return answer;
    }
}
