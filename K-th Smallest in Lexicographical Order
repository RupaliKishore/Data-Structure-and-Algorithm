K-th Smallest in Lexicographical Order



class Solution {
    public int findKthNumber(int n, int k) {
        int curr = 1;
        k--; // We start at 1, so decrement k
        
        while (k > 0) {
            long count = countNumbersWithPrefix(curr, n);
            if (count <= k) {
                // Skip entire subtree
                k -= count;
                curr++;
            } else {
                // Go deeper
                curr *= 10;
                k--;
            }
        }
        
        return curr;
    }
    
    private long countNumbersWithPrefix(long prefix, int n) {
        long count = 0;
        long first = prefix;
        long last = prefix;
        
        while (first <= n) {
            count += Math.min(last, n) - first + 1;
            first *= 10;
            last = last * 10 + 9;
        }
        
        return count;
    }
}
