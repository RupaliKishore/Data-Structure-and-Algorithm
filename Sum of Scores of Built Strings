Sum of Scores of Built Strings




class Solution {
    public long sumScores(String s) {
        int n = s.length();
        int[] z = computeZ(s);
        
        long sum = 0;
        for (int i = 0; i < n; i++) {
            sum += z[i];
        }
        
        return sum;
    }
    
    private int[] computeZ(String s) {
        int n = s.length();
        int[] z = new int[n];
        int l = 0, r = 0;
        
        for (int i = 1; i < n; i++) {
            if (i <= r) {
                z[i] = Math.min(r - i + 1, z[i - l]);
            }
            
            while (i + z[i] < n && s.charAt(z[i]) == s.charAt(i + z[i])) {
                z[i]++;
            }
            
            if (i + z[i] - 1 > r) {
                l = i;
                r = i + z[i] - 1;
            }
        }
        
        // By definition, Z[0] is the length of the whole string
        // But the problem might consider it as n (since prefix matches whole string)
        // However, we need to be careful about problem requirements
        z[0] = n; // Add this if suffix starting at 0 counts full length
        
        return z;
    }
}
