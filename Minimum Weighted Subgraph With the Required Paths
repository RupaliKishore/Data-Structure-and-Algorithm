    public static void main(String[] args) {
        Solution sol = new Solution();
        
        // Example from problem
        int n = 6;
        int[][] edges = {{0,2,2}, {0,5,6}, {1,0,3}, {1,4,5}, {2,1,1}, {2,3,3}, {2,3,4}, {3,4,2}, {4,5,1}};
        int src1 = 0, src2 = 1, dest = 5;
        System.out.println(sol.minimumWeight(n, edges, src1, src2, dest)); // 9
        
        // Additional test
        int n2 = 3;
        int[][] edges2 = {{0,1,1}, {1,2,1}, {0,2,5}};
        System.out.println(sol.minimumWeight(n2, edges2, 0, 1, 2)); // 3? 0→2 direct=5, or 0→1→2=1+1=2? But src2=1→2=1, so total 0→1→2 uses edges 0-1 and 1-2 weight 2, but src2 path uses 1-2 weight 1, shared, so total weight 2? Actually need to compute properly.
