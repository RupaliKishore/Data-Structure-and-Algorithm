Longest Repeating Character Replacement





class Solution {
    public int characterReplacement(String s, int k) {
        int[] count = new int[26]; // Count of each character in current window
        int left = 0;
        int maxFreq = 0; // Maximum frequency of any character in current window
        int maxLength = 0;
        
        for (int right = 0; right < s.length(); right++) {
            // Add current character to window
            char c = s.charAt(right);
            count[c - 'A']++;
            
            // Update max frequency in current window
            maxFreq = Math.max(maxFreq, count[c - 'A']);
            
            // If window size - max frequency > k, we need to shrink window
            while (right - left + 1 - maxFreq > k) {
                char leftChar = s.charAt(left);
                count[leftChar - 'A']--;
                left++;
                // Note: maxFreq might decrease, but we don't need to update it
                // because we only care about valid windows and maxFreq may be lower
                // but it's okay to keep it as is (it won't affect the result)
            }
            
            // Update maximum length
            maxLength = Math.max(maxLength, right - left + 1);
        }
        
        return maxLength;
    }
}
