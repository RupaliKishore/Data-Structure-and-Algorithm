Longest Univalue Path



/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    private int maxLength = 0;
    
    public int longestUnivaluePath(TreeNode root) {
        if (root == null) return 0;
        dfs(root);
        return maxLength;
    }
    
    private int dfs(TreeNode node) {
        if (node == null) return 0;
        
        // Get the longest univalue path from left and right children
        int left = dfs(node.left);
        int right = dfs(node.right);
        
        int leftPath = 0, rightPath = 0;
        
        // If left child exists and has same value, extend the path
        if (node.left != null && node.left.val == node.val) {
            leftPath = left + 1;
        }
        
        // If right child exists and has same value, extend the path
        if (node.right != null && node.right.val == node.val) {
            rightPath = right + 1;
        }
        
        // Update global maximum: path through current node
        maxLength = Math.max(maxLength, leftPath + rightPath);
        
        // Return the longer branch to parent
        return Math.max(leftPath, rightPath);
    }
}
