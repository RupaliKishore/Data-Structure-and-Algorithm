Find Building Where Alice and Bob Can Meet



import java.util.*;

public class FindBuildingWhereAliceBobMeet {
    public static void main(String[] args) {
        Solution sol = new Solution();
        
        int[] heights = {6, 4, 8, 5, 2, 7};
        int[][] queries = {{0, 1}, {0, 3}, {2, 5}, {3, 4}, {1, 2}};
        
        int[] result = sol.leftmostBuildingQueries(heights, queries);
        System.out.println(Arrays.toString(result));
        // Expected: [2, 2, 5, -1, 2]
    }
}

class Solution {
    public int[] leftmostBuildingQueries(int[] heights, int[][] queries) {
        int n = heights.length;
        int q = queries.length;
        int[] ans = new int[q];
        
        // Build sparse table for range maximum
        int log = (int) (Math.log(n) / Math.log(2)) + 1;
        int[][] st = new int[n][log];
        
        for (int i = 0; i < n; i++) {
            st[i][0] = heights[i];
        }
        
        for (int j = 1; j < log; j++) {
            for (int i = 0; i + (1 << j) <= n; i++) {
                st[i][j] = Math.max(st[i][j - 1], st[i + (1 << (j - 1))][j - 1]);
            }
        }
        
        for (int qi = 0; qi < q; qi++) {
            int a = queries[qi][0];
            int b = queries[qi][1];
            
            if (a == b) {
                ans[qi] = a;
                continue;
            }
            
            // Ensure a < b
            if (a > b) {
                int temp = a;
                a = b;
                b = temp;
            }
            
            // If Alice can directly reach Bob's starting point
            if (heights[a] < heights[b]) {
                ans[qi] = b;
                continue;
            }
            
            // Binary search for the leftmost building > b where max height >= heights[a]
            int target = heights[a];
            int left = b, right = n - 1;
            int idx = -1;
            
            while (left <= right) {
                int mid = left + (right - left) / 2;
                int maxInRange = getMax(st, b, mid);
                if (maxInRange > target) {
                    idx = mid;
                    right = mid - 1;
                } else {
                    left = mid + 1;
                }
            }
            
            ans[qi] = idx;
        }
        
        return ans;
    }
    
    private int getMax(int[][] st, int l, int r) {
        int len = r - l + 1;
        int k = (int) (Math.log(len) / Math.log(2));
        return Math.max(st[l][k], st[r - (1 << k) + 1][k]);
    }
}
