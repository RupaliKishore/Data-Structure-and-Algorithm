Add Edges to Make Degrees of All Nodes Even



import java.util.*;

class Solution {
    public boolean isPossible(int n, List<List<Integer>> edges) {
        // Build adjacency sets for O(1) lookup
        @SuppressWarnings("unchecked")
        Set<Integer>[] adj = new HashSet[n + 1];
        for (int i = 1; i <= n; i++) {
            adj[i] = new HashSet<>();
        }
        
        // Calculate degrees and populate adjacency sets
        int[] degree = new int[n + 1];
        for (List<Integer> edge : edges) {
            int u = edge.get(0);
            int v = edge.get(1);
            adj[u].add(v);
            adj[v].add(u);
            degree[u]++;
            degree[v]++;
        }
        
        // Find nodes with odd degree
        List<Integer> odd = new ArrayList<>();
        for (int i = 1; i <= n; i++) {
            if (degree[i] % 2 == 1) {
                odd.add(i);
            }
        }
        
        int m = odd.size();
        
        // Case 1: Already all even
        if (m == 0) return true;
        
        // Case 2: Impossible cases
        if (m == 1 || m == 3 || m > 4) return false;
        
        // Case 3: 2 odd nodes
        if (m == 2) {
            int a = odd.get(0), b = odd.get(1);
            // Try adding direct edge
            if (!adj[a].contains(b)) return true;
            
            // Try using a hub node
            for (int c = 1; c <= n; c++) {
                if (c != a && c != b && !adj[a].contains(c) && !adj[b].contains(c)) {
                    return true;
                }
            }
            return false;
        }
        
        // Case 4: 4 odd nodes
        // m == 4
        int a = odd.get(0), b = odd.get(1), c = odd.get(2), d = odd.get(3);
        
        // Try all 3 pairings
        return (!adj[a].contains(b) && !adj[c].contains(d)) ||
               (!adj[a].contains(c) && !adj[b].contains(d)) ||
               (!adj[a].contains(d) && !adj[b].contains(c));
    }
}
